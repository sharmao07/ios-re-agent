{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "iOS-RE Agent report",
  "description": "Machine-readable static-inspection report. Findings are not proof of runtime behavior.",
  "type": "object",
  "required": ["schema_version", "tool", "generated_at", "input", "limitations"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "ios-re-agent" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["ipa", "app_bundle", "macho_binary"] }
      },
      "additionalProperties": true
    },
    "app": { "type": "object" },
    "inventory": { "type": "object" },
    "macho": { "type": "object" },
    "network_indicators": {
      "type": "object",
      "properties": {
        "candidate_endpoints": { "type": "array", "items": { "type": "string" } },
        "candidate_hosts": { "type": "array", "items": { "type": "string" } },
        "reference_urls": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "host": { "type": "string" },
              "classification": { "type": "string" },
              "source_path": { "type": "string" },
              "byte_offset": { "type": "integer", "minimum": 0 },
              "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
            },
            "required": ["url", "source_path", "classification"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "keyword_indicators": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "keyword_evidence": { "type": "object" },
    "feature_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "confidence", "summary", "evidence"],
        "properties": {
          "feature": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "summary": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_path", "reason"],
              "properties": { "source_path": { "type": "string" }, "reason": { "type": "string" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "scan": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
